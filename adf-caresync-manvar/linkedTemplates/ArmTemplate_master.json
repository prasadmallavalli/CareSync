{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-caresync-manvar"
		},
		"AKVCaresync_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresync-manvar.vault.azure.net/"
		},
		"ls_adb_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1126-223818-kb8622sb"
		},
		"ls_azuresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresyncserver83.database.windows.net"
		},
		"ls_azuresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "caresync"
		},
		"ls_azuresql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admincaresync"
		},
		"ls_postgresql_caresync_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-dark-rain-bbd1canl-pooler.c-15.us-east-1.aws.neon.tech"
		},
		"ls_postgresql_caresync_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_postgresql_caresync_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"ls_sacaresync_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sgcaresyncmanvar.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-caresync-manvar_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AKVCaresync_properties_typeProperties_baseUrl": {
						"value": "[parameters('AKVCaresync_properties_typeProperties_baseUrl')]"
					},
					"ls_sacaresync_properties_typeProperties_url": {
						"value": "[parameters('ls_sacaresync_properties_typeProperties_url')]"
					},
					"ls_adb_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_adb_properties_typeProperties_existingClusterId')]"
					},
					"ls_azuresql_properties_typeProperties_server": {
						"value": "[parameters('ls_azuresql_properties_typeProperties_server')]"
					},
					"ls_azuresql_properties_typeProperties_database": {
						"value": "[parameters('ls_azuresql_properties_typeProperties_database')]"
					},
					"ls_azuresql_properties_typeProperties_userName": {
						"value": "[parameters('ls_azuresql_properties_typeProperties_userName')]"
					},
					"ls_postgresql_caresync_properties_typeProperties_server": {
						"value": "[parameters('ls_postgresql_caresync_properties_typeProperties_server')]"
					},
					"ls_postgresql_caresync_properties_typeProperties_database": {
						"value": "[parameters('ls_postgresql_caresync_properties_typeProperties_database')]"
					},
					"ls_postgresql_caresync_properties_typeProperties_username": {
						"value": "[parameters('ls_postgresql_caresync_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}